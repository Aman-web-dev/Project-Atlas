# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for BYOK (Bring Your Own Key). The service role bypasses RLS so
# the server can write secrets into Supabase Vault on behalf of the user.
# Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Services — used by the legacy Lambda functions (platform-provided mode).
# When BYOK is enabled (a user has saved their own key in Settings), these are
# NOT used; Atlas calls OpenAI directly with the user's key.
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_AI_API_KEY=your-google-ai-key

# Lambda function URLs (deployed via AWS SAM/CloudFormation)
NEXT_PUBLIC_LAMBDA_AI_COPY_URL=https://your-api-id.execute-api.region.amazonaws.com/prod/copy
NEXT_PUBLIC_LAMBDA_AI_IMAGE_URL=https://your-api-id.execute-api.region.amazonaws.com/prod/image

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
